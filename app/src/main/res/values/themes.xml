<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ProjectMayhem" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/mayhem_red</item>
        <item name="android:windowBackground">@color/mayhem_black</item>
        <item name="android:navigationBarColor">@color/mayhem_black</item>
        <item name="android:statusBarColor">@color/mayhem_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowContentTransitions">false</item>
    </style>

    <style name="Theme.ProjectMayhem.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mayhem_black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.ProjectMayhem</item>
    </style>
</resources>
